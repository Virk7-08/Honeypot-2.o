<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Reset password — <%= companyName %></title>
<link rel="stylesheet" href="/honeypot/style.css">
</head>
<body>
  <div class="split">
    <div class="side-panel">
      <div class="side-inner">
        <div class="logo-mark"><%= companyName.charAt(0) %></div>
        <h1><%= companyName %></h1>
        <p>Secure access to internal systems, tools and resources. Use your company credentials to continue.</p>
        <ul class="side-list">
          <li>Single sign-on across internal apps</li>
          <li>Access monitored for your security</li>
          <li>Need help? Contact IT Support</li>
        </ul>
      </div>
    </div>
    <div class="form-panel">
      <div class="form-inner">
        <h2>Reset your password</h2>
        <p class="sub">Enter your company email and we'll send a verification code.</p>

        <form method="POST" action="/forgot-password">
          <label for="email">Company email</label>
          <input id="email" type="email" name="email" autocomplete="email" placeholder="you@company.com" required autofocus>

          <button type="submit">Send code</button>
        </form>

        <div class="notice"><a href="/" class="link-muted">&larr; Back to sign in</a></div>
      </div>
    </div>
  </div>
</body>
</html>
