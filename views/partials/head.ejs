<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= brand %></title>
<link rel="stylesheet" href="/static/style.css">
</head>
<body>
<div class="app-shell">
  <aside class="sidebar">
    <div class="sidebar-brand">
      <div class="brand-mark">V</div>
      <div class="brand-text"><%= brand %></div>
    </div>
    <div class="live-indicator"><span class="pulse-dot"></span> Live monitoring</div>

    <nav class="sidebar-nav">
      <a href="/terminal" class="nav-item <%= active === 'terminal' ? 'active' : '' %>">
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M7 9l3 3-3 3"/><path d="M12 15h5"/></svg>
        Terminal
      </a>
      <a href="/" class="nav-item <%= active === 'traffic' ? 'active' : '' %>">
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12h4l3 8 4-16 3 8h4"/></svg>
        Traffic
      </a>
      <a href="/unknown-traffic" class="nav-item <%= active === 'unknown' ? 'active' : '' %>">
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M9.5 9a2.5 2.5 0 0 1 5 0c0 1.5-2.5 2-2.5 3.5"/><path d="M12 17h.01"/></svg>
        Unknown Traffic
      </a>
      <a href="/attackers" class="nav-item <%= active === 'attackers' ? 'active' : '' %>">
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.5 3.5L12 2l1.5 1.5L15 2l1 2 2-1-.5 2.2L20 6l-1.8 1.3L19 9.5l-2.2-.3L16 11l-1.7-1.3L13 11l-.8-1.8L10.5 10l.3-2.2L9 6.5l2-1.2-.5-1.8z"/><circle cx="9" cy="16" r="3"/><path d="M15 19l2-2"/></svg>
        Attacker Info
      </a>
      <a href="/history" class="nav-item <%= active === 'history' ? 'active' : '' %>">
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v5h5"/><path d="M3.05 13a9 9 0 1 0 2.36-8.36L3 8"/><path d="M12 7v5l4 2"/></svg>
        History
      </a>
      <a href="/alert" class="nav-item <%= active === 'alert' ? 'active' : '' %>">
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
        Alert Security Team
      </a>
    </nav>

    <a href="/logout" class="nav-item logout-item">
      <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><path d="M16 17l5-5-5-5"/><path d="M21 12H9"/></svg>
      Logout
    </a>
  </aside>

  <main class="main-content">
    <div class="container">
