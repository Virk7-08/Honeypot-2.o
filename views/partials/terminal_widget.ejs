<button class="term-fab" id="termFab" title="Open terminal">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M7 9l3 3-3 3"/><path d="M12 15h5"/></svg>
</button>

<div class="term-modal-overlay" id="termModalOverlay">
  <div class="terminal-window term-modal">
    <div class="terminal-titlebar">
      <span class="term-dot red"></span>
      <span class="term-dot yellow"></span>
      <span class="term-dot green"></span>
      <span class="term-title">quick terminal</span>
      <button class="term-modal-close" id="termModalClose">&#10005;</button>
    </div>
    <div class="terminal-body" id="fabTermBody">
      <div class="term-line banner">Quick terminal — type "help" and press Enter. Esc to close.</div>
      <div class="term-line">&nbsp;</div>
      <div class="term-input-row">
        <span class="term-prompt-label">$</span>
        <input type="text" class="term-input" id="fabTermInput" autocomplete="off" spellcheck="false">
      </div>
    </div>
  </div>
</div>

<script>
(function () {
  var fab = document.getElementById('termFab');
  var overlay = document.getElementById('termModalOverlay');
  var closeBtn = document.getElementById('termModalClose');
  var body = document.getElementById('fabTermBody');
  var input = document.getElementById('fabTermInput');
  var history = [], histIndex = -1;

  function openModal() { overlay.classList.add('open'); input.focus(); }
  function closeModal() { overlay.classList.remove('open'); }

  fab.addEventListener('click', openModal);
  closeBtn.addEventListener('click', closeModal);
  overlay.addEventListener('click', function (e) { if (e.target === overlay) closeModal(); });
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && overlay.classList.contains('open')) closeModal();
  });

  function appendLine(text, cls) {
    var div = document.createElement('div');
    div.className = 'term-line' + (cls ? ' ' + cls : '');
    div.textContent = text;
    body.insertBefore(div, body.lastElementChild);
    body.scrollTop = body.scrollHeight;
  }

  function runCommand(cmd) {
    appendLine('$ ' + cmd, 'cmd');
    if (cmd.trim().toLowerCase() === 'clear' || cmd.trim().toLowerCase() === 'cls') {
      Array.from(body.querySelectorAll('.term-line')).forEach(function (el) { el.remove(); });
      return;
    }
    fetch('/api/terminal', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ command: cmd })
    })
      .then(function (r) { return r.json(); })
      .then(function (data) {
        if (data.output) appendLine(data.output, data.error ? 'err' : '');
        body.scrollTop = body.scrollHeight;
      })
      .catch(function () { appendLine('error: could not reach server', 'err'); });
  }

  input.addEventListener('keydown', function (e) {
    if (e.key === 'Enter') {
      var cmd = input.value;
      input.value = '';
      if (cmd.trim()) { history.push(cmd); histIndex = history.length; }
      runCommand(cmd);
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      if (histIndex > 0) { histIndex--; input.value = history[histIndex] || ''; }
    } else if (e.key === 'ArrowDown') {
      e.preventDefault();
      if (histIndex < history.length - 1) { histIndex++; input.value = history[histIndex] || ''; }
      else { histIndex = history.length; input.value = ''; }
    }
  });
})();
</script>
